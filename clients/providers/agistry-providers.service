# Run this host's agistry resource providers as a user service. Preferred over
# session-driven autostart on a machine that permanently owns devices: it starts at
# boot, restarts on failure, and does not depend on anyone opening a Claude session.
#
#   mkdir -p ~/.config/systemd/user
#   cp agistry-providers.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now agistry-providers
#
# Providers still come from AGISTRY_PROVIDERS in ~/.config/agistry/client.env, so a
# host with none configured starts nothing.
[Unit]
Description=agistry resource providers (announce this host's devices)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.claude/providers/agistry-providers.sh start
ExecStop=%h/.claude/providers/agistry-providers.sh stop
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
