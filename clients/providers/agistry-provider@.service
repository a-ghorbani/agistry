# Runs ONE agistry resource provider under systemd, in the foreground, so systemd
# notices if it dies and restarts it. The instance name is the provider:
# agistry-provider@adb runs agistry-adb-provider.sh. clients/providers/install.sh
# installs this unit and enables an instance per name in AGISTRY_PROVIDERS.
[Unit]
Description=agistry %i resource provider (announce this host's %i devices)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.config/agistry/providers/agistry-%i-provider.sh --loop
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
