#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${TMUX:-}" ]]; then
  echo "Run tmux-main in a terminal pane outside tmux." >&2
  exit 1
fi

mkdir -p "$HOME/.cache"
# One main client at a time: the sidebar only drives the newest, so an older one left
# open in another terminal would sit there looking like it ignores the sidebar. Detach
# it (its terminal goes back to the shell; the sessions stay).
old_pid="$(cat "$HOME/.cache/tmux-main-pid" 2>/dev/null || true)"
if [[ -n "$old_pid" ]]; then
  old_tty="$(tmux list-clients -F '#{client_pid} #{client_tty}' 2>/dev/null \
             | awk -v pid="$old_pid" '$1 == pid { print $2 }' || true)"
  [[ -n "$old_tty" ]] && tmux detach-client -t "$old_tty" 2>/dev/null || true
fi
tty > "$HOME/.cache/tmux-main-tty"
# exec keeps this PID, so the sidebar can find the client even if the tty file goes stale.
echo $$ > "$HOME/.cache/tmux-main-pid"

# The autoname hook renames sessions, so remember the main session by its ID, not "main".
id_file="$HOME/.cache/tmux-main-session"
id="$(cat "$id_file" 2>/dev/null || true)"
if [[ -z "$id" ]] || ! tmux has-session -t "$id" 2>/dev/null; then
  id="$(tmux new-session -d -P -F '#{session_id}' -s main 2>/dev/null \
        || tmux display-message -p -t '=main' '#{session_id}')"
  echo "$id" > "$id_file"
fi
# When the session on screen ends (exit, kill-session), move to the most recently
# active remaining session instead of detaching and ending tmux-main. It is a session
# option and the main client roams every session, so it has to be global.
tmux set -g detach-on-destroy off
exec tmux attach-session -t "$id"
